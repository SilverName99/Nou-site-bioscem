APP_NAME="Bioscem Shop"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Bucharest

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bioscem_shop
DB_USERNAME=root
DB_PASSWORD=

ADMIN_DEFAULT_EMAIL=admin@bioscem.ro
ADMIN_DEFAULT_PASSWORD=ChangeMe123!

# Banca Transilvania iPay: datele de acces primite de la bancă, separat pentru
# test (sandbox) și producție. Se completează DOAR în .env-ul de pe server,
# niciodată în git, pe email sau pe chat. Modificarea se aplică imediat.
# BT_IPAY_MODE=test folosește platforma de test a băncii; live = producție.
BT_IPAY_MODE=test
BT_IPAY_TEST_USER=
BT_IPAY_TEST_PASS=
BT_IPAY_TEST_CALLBACK_KEY=
BT_IPAY_LIVE_USER=
BT_IPAY_LIVE_PASS=
BT_IPAY_LIVE_CALLBACK_KEY=
# Doar pentru teste locale, cu un server care imită banca. Pe site-ul live rămâne gol.
BT_IPAY_BASE_URL_OVERRIDE=

# Avertismentul pe produs (ex. „ATENȚIE – PRODUS REFRIGERAT”): fereastra la adăugarea
# în coș, caseta + bifa obligatorie la finalizarea comenzii, blocul din email.
# Oprire de urgență: AVERTISMENT_PRODUSE=0 (textele din admin și confirmările vechi rămân).
# AVERTISMENT_PRODUSE=1

# SEO: opriri de urgență, doar la nevoie (implicit totul e pornit; vezi README, „SEO: …”).
# SEO_REDIRECTURI=0    redirecționările (www, „/” final, adresele vechi, categoriile)
# SEO_TITLURI=0        titlurile și descrierile de dinainte de livrarea 2
# SEO_LIVRARE_RETUR=0  livrarea (cu termenul de livrare) și returul, din datele pentru Google și din flux
# SEO_NOINDEX=0        fără noindex pe /magazin?q=… și pe /blog gol; canonical la loc pe 404;
#                      /blog/x și /categorie/x inexistente răspund ca înainte (text simplu / tot magazinul)
# SEO_H1=0             fără H1-ul pus de șablon pe paginile din constructor fără <h1>; pe /blog titlul rămâne H2
# SEO_POZE=0           fără width/height-ul adăugat în livrarea 4 și fără pozele mari refăcute (WebP)
# SEO_PRODUSE_SIMILARE=0  „Produse similare” ca înainte: doar cele alese în admin, desenate din JavaScript
